# Copy this file to .env for local overrides (optional — most things work without it)

# Your Anthropic API key (can also be set in the app's Settings page)
ANTHROPIC_API_KEY=sk-ant-...

# Port (default: 3000)
PORT=3000

# Set to 'production' on cloud platforms to disable local HTTPS cert generation
NODE_ENV=development

# Path where the database and uploads are stored.
# On Railway/Render, point this to your mounted volume path (e.g. /data)
# Leave blank locally — defaults to the project folder
DATA_DIR=
